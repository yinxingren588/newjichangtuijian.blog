---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  tags: string[];
  keywords?: string;
  rating?: number;
  slug: string;
}

const { title, description, pubDate, updatedDate, author, tags, keywords, rating, slug } = Astro.props;

const breadcrumbs = [
  { name: '评测文章', url: '/posts/' },
  { name: title, url: `/posts/${slug}/` },
];

const formattedPubDate = pubDate.toISOString().split('T')[0];
const formattedUpDate = updatedDate ? updatedDate.toISOString().split('T')[0] : null;
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords || `${title}, 2027机场推荐, newjichangtuijian.blog`}
  article={{ pubDate, updatedDate, author, tags }}
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-4xl mx-auto">
    <!-- 面包屑导航 -->
    <Breadcrumb items={breadcrumbs} />

    <!-- 文章头信息 -->
    <header class="mb-10 pb-8 border-b border-slate-200">
      <div class="flex flex-wrap gap-2 mb-4">
        {tags.map((tag) => (
          <span class="px-2.5 py-1 rounded-md text-xs font-semibold bg-sky-50 text-sky-700 border border-sky-200">
            #{tag}
          </span>
        ))}
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">
        {title}
      </h1>

      <p class="text-slate-600 text-base sm:text-lg leading-relaxed mb-6 font-normal">
        {description}
      </p>

      <div class="flex items-center justify-between flex-wrap gap-4 text-xs text-slate-500 bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
        <div class="flex items-center space-x-4">
          <div class="flex items-center space-x-2">
            <span class="w-7 h-7 rounded-full bg-sky-100 flex items-center justify-center text-sky-700 font-bold">
              评
            </span>
            <span class="font-medium text-slate-700">{author}</span>
          </div>
          <span>·</span>
          <time datetime={pubDate.toISOString()}>发布日期: {formattedPubDate}</time>
          {formattedUpDate && (
            <>
              <span>·</span>
              <span class="text-emerald-600 font-medium">最后更新: {formattedUpDate}</span>
            </>
          )}
        </div>

        {rating && (
          <div class="flex items-center text-amber-500 font-bold text-sm">
            <svg class="w-4 h-4 fill-current mr-1" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            <span>综合推荐指数: {rating}.0 / 5.0</span>
          </div>
        )}
      </div>
    </header>

    <!-- 文章正文区域 -->
    <article class="prose-custom max-w-none bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-sm">
      <slot />
    </article>

    <!-- 底部行动号召 CTA 区域 -->
    <div class="my-12 p-8 rounded-2xl bg-gradient-to-br from-sky-50 via-white to-blue-50 border border-sky-200 text-center relative overflow-hidden shadow-sm">
      <div class="relative z-10">
        <h3 class="text-2xl font-bold text-slate-900 mb-2">正在寻找 2027 稳定高速的优质机场？</h3>
        <p class="text-slate-600 text-sm max-w-xl mx-auto mb-6">
          查看本站最新出炉的《2027优质机场推荐综合排行榜》，涵盖全IEPL专线、唯云专线、支持4K秒开与ChatGPT解锁节点，带您避开跑路风险。
        </p>
        <a
          href="/#ranking"
          class="inline-flex items-center px-6 py-3 rounded-xl font-bold text-sm bg-gradient-to-r from-sky-500 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white shadow-md shadow-sky-500/20 transition-transform hover:scale-105"
        >
          查看 2027 机场推荐排行榜 TOP 榜单 →
        </a>
      </div>
    </div>

    <!-- 版权声明 -->
    <div class="p-4 rounded-xl bg-slate-100 border border-slate-200 text-xs text-slate-600 leading-relaxed">
      <p><strong class="text-slate-800">版权声明：</strong>本文为 newjichangtuijian.blog 原创评测，首发于官方域名 <a href="https://newjichangtuijian.blog" class="text-sky-600 underline">https://newjichangtuijian.blog</a>。转载请保留原始出处与链接。本站所有测评仅作技术交流与合规研究使用。</p>
    </div>
  </div>
</BaseLayout>
