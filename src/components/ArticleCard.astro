---
export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  tags?: string[];
  heroImage?: string;
  rating?: number;
}

const { title, description, pubDate, slug, tags = ['2027机场推荐'], rating } = Astro.props;
const formattedDate = pubDate.toISOString().split('T')[0];
---

<article class="glass-card rounded-2xl p-6 border border-slate-200 bg-white flex flex-col justify-between group hover:border-sky-300 transition-all shadow-sm">
  <div>
    <!-- 标签与日期 -->
    <div class="flex items-center justify-between text-xs text-slate-500 mb-3 flex-wrap gap-2">
      <div class="flex items-center space-x-1.5">
        {tags.slice(0, 2).map((tag) => (
          <span class="px-2 py-0.5 rounded bg-sky-50 text-sky-700 border border-sky-200 text-[11px] font-medium">
            #{tag}
          </span>
        ))}
      </div>
      <time datetime={pubDate.toISOString()} class="text-slate-400 font-mono text-[11px]">
        {formattedDate}
      </time>
    </div>

    <!-- 标题 -->
    <h3 class="text-lg font-bold text-slate-900 group-hover:text-sky-600 transition-colors line-clamp-2 mb-2">
      <a href={`/posts/${slug}/`}>
        {title}
      </a>
    </h3>

    <!-- 摘要 -->
    <p class="text-slate-600 text-sm leading-relaxed line-clamp-3 mb-4">
      {description}
    </p>
  </div>

  <div class="flex items-center justify-between pt-4 border-t border-slate-100 mt-2 text-xs">
    {rating ? (
      <div class="flex items-center text-amber-500 font-semibold">
        <svg class="w-3.5 h-3.5 fill-current mr-1" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
        </svg>
        <span>评测评分: {rating}.0</span>
      </div>
    ) : (
      <span class="text-slate-500 font-medium">2027精选教程</span>
    )}

    <a
      href={`/posts/${slug}/`}
      class="text-sky-600 font-semibold group-hover:translate-x-1 transition-transform inline-flex items-center"
    >
      阅读全文
      <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</article>
