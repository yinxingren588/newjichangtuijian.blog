---
export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  article?: {
    pubDate: Date;
    updatedDate?: Date;
    author: string;
    tags: string[];
  };
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const {
  title = '2027机场推荐 | 最新稳定高速翻墙机场评测与节点选购指南',
  description = '2027机场推荐官方测评博客（newjichangtuijian.blog），为您精选2027年最稳定、高速的IEPL专线机场、Trojan/Hysteria2机场与低延迟梯子节点，支持4K/8K视频秒开与ChatGPT解锁。',
  keywords = '2027机场推荐, 2027翻墙机场, 高速机场推荐, 稳定梯子, IEPL专线机场, 便宜好用机场, 科学上网, Clash节点, Shadowrocket节点, newjichangtuijian.blog',
  image = '/og-image.png',
  article,
  breadcrumbs,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://newjichangtuijian.blog');
const siteName = '2027机场推荐 - newjichangtuijian.blog';
const formattedTitle = title.includes('2027机场推荐') ? title : `${title} - 2027机场推荐 | newjichangtuijian.blog`;

// 网站结构化数据
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': '2027机场推荐',
  'url': 'https://newjichangtuijian.blog/',
  'description': '专业2027机场推荐评测博客，定期更新优质翻墙梯子节点与科学上网指南。',
  'potentialAction': {
    '@type': 'SearchAction',
    'target': 'https://newjichangtuijian.blog/?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};

// 文章结构化数据
const articleSchema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      'headline': title,
      'description': description,
      'image': new URL(image, canonicalURL).toString(),
      'datePublished': article.pubDate.toISOString(),
      'dateModified': (article.updatedDate || article.pubDate).toISOString(),
      'author': {
        '@type': 'Person',
        'name': article.author,
      },
      'publisher': {
        '@type': 'Organization',
        'name': '2027机场推荐团队',
        'logo': {
          '@type': 'ImageObject',
          'url': 'https://newjichangtuijian.blog/favicon.svg',
        },
      },
      'mainEntityOfPage': {
        '@type': 'WebPage',
        '@id': canonicalURL.toString(),
      },
    }
  : null;

// 面包屑结构化数据 (Bing 优先支持)
const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      'itemListElement': breadcrumbs.map((crumb, idx) => ({
        '@type': 'ListItem',
        'position': idx + 1,
        'name': crumb.name,
        'item': new URL(crumb.url, 'https://newjichangtuijian.blog').toString(),
      })),
    }
  : null;
---

<!-- 基础元数据 -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{formattedTitle}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="author" content="2027机场推荐团队" />
<link rel="canonical" href={canonicalURL} />

<!-- 图标与站点地图声明 -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="shortcut icon" href="/favicon.svg" />
<link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />

<!-- 搜索引擎爬虫指令 (Bing / Google) -->
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
<meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
<meta name="googlebot" content="index, follow" />

<!-- Bing Webmaster 预留验证标签（站长可在此填入验证码） -->
<meta name="msvalidate.01" content="BING_VERIFICATION_CODE_PLACEHOLDER" />

<!-- Open Graph 社交协议 -->
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={formattedTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:image" content={new URL(image, canonicalURL).toString()} />
<meta property="og:locale" content="zh_CN" />

{article && (
  <meta property="article:published_time" content={article.pubDate.toISOString()} />
  <meta property="article:modified_time" content={(article.updatedDate || article.pubDate).toISOString()} />
  <meta property="article:author" content={article.author} />
)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={formattedTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, canonicalURL).toString()} />

<!-- DNS 预解析加速 -->
<link rel="dns-prefetch" href="//api.indexnow.org" />

<!-- JSON-LD 结构化数据注入 -->
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
{articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
{breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
