---
import type { AirportItem } from './AirportCard.astro';

export interface Props {
  airports: AirportItem[];
}

const { airports } = Astro.props;
---

<div class="space-y-4">
  <!-- 搜索与筛选工具栏 -->
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 p-4 rounded-xl bg-white border border-slate-200 shadow-sm">
    <div class="flex items-center space-x-2 text-sm text-slate-600 w-full sm:w-auto">
      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
      <span>已收录并监控：<strong class="text-slate-900 font-mono">{airports.length}</strong> 家优质翻墙机场</span>
    </div>

    <div class="relative w-full sm:w-72">
      <input
        type="text"
        id="airport-table-search"
        placeholder="搜索机场名称、协议、线路..."
        class="w-full px-4 py-2 pl-9 rounded-lg bg-slate-50 border border-slate-300 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:border-sky-500 focus:bg-white transition-colors"
      />
      <svg class="w-4 h-4 text-slate-400 absolute left-3 top-3 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>
  </div>

  <!-- 对比表格 -->
  <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
    <table class="w-full text-left border-collapse text-sm" id="airports-table">
      <thead>
        <tr class="bg-slate-50 border-b border-slate-200 text-slate-700">
          <th class="py-4 px-4 font-semibold text-sky-700">排名 / 品牌名称</th>
          <th class="py-4 px-4 font-semibold">专线线路特色</th>
          <th class="py-4 px-4 font-semibold">支持协议</th>
          <th class="py-4 px-4 font-semibold">流媒体与AI解锁</th>
          <th class="py-4 px-4 font-semibold">晚高峰实测</th>
          <th class="py-4 px-4 font-semibold">起步价格</th>
          <th class="py-4 px-4 font-semibold text-center">直达通道</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100" id="airports-table-body">
        {airports.map((airport) => (
          <tr class="hover:bg-sky-50/40 transition-colors airport-row" data-name={airport.name.toLowerCase()} data-features={airport.features.join(' ').toLowerCase()} data-protocols={airport.protocols.join(' ').toLowerCase()}>
            <td class="py-4 px-4">
              <div class="flex items-center space-x-2">
                <span class={`inline-flex items-center justify-center w-6 h-6 rounded text-xs font-bold ${
                  airport.rank === 1 ? 'bg-amber-400 text-white' :
                  airport.rank === 2 ? 'bg-slate-700 text-white' :
                  airport.rank === 3 ? 'bg-amber-700 text-white' :
                  'bg-slate-100 text-slate-600 border border-slate-200'
                }`}>
                  {airport.rank}
                </span>
                <span class="font-bold text-slate-900 hover:text-sky-600 transition-colors">
                  {airport.name}
                </span>
              </div>
              {airport.badge && (
                <span class="inline-block mt-1 text-[10px] px-2 py-0.5 rounded bg-sky-50 text-sky-700 border border-sky-200">
                  {airport.badge}
                </span>
              )}
            </td>
            <td class="py-4 px-4">
              <span class="text-xs px-2 py-1 rounded bg-slate-100 text-slate-700 border border-slate-200 whitespace-nowrap">
                {airport.highlights[0] || '全IEPL专线'}
              </span>
            </td>
            <td class="py-4 px-4">
              <div class="flex flex-wrap gap-1">
                {airport.protocols.slice(0, 3).map((p) => (
                  <span class="text-[11px] font-mono px-1.5 py-0.5 rounded bg-slate-50 text-sky-700 border border-slate-200">
                    {p}
                  </span>
                ))}
              </div>
            </td>
            <td class="py-4 px-4">
              <span class="text-xs text-emerald-600 font-medium flex items-center whitespace-nowrap">
                <svg class="w-3.5 h-3.5 mr-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                ChatGPT / 4K原生
              </span>
            </td>
            <td class="py-4 px-4 font-mono font-semibold text-sky-600 whitespace-nowrap">
              {airport.speedScore} Mbps
            </td>
            <td class="py-4 px-4 font-bold text-slate-900 whitespace-nowrap">
              {airport.entryPrice}
            </td>
            <td class="py-4 px-4 text-center whitespace-nowrap">
              <a
                href={airport.affUrl}
                target="_blank"
                rel="nofollow noopener noreferrer"
                class="inline-block px-3 py-1.5 rounded-lg text-xs font-semibold bg-sky-600 hover:bg-sky-500 text-white shadow-sm transition-all hover:scale-105"
              >
                直达官网 →
              </a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<script>
  const searchInput = document.getElementById('airport-table-search') as HTMLInputElement | null;
  const rows = document.querySelectorAll<HTMLTableRowElement>('.airport-row');

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.trim().toLowerCase();
      rows.forEach((row) => {
        const name = row.getAttribute('data-name') || '';
        const features = row.getAttribute('data-features') || '';
        const protocols = row.getAttribute('data-protocols') || '';
        if (!query || name.includes(query) || features.includes(query) || protocols.includes(query)) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    });
  }
</script>
