---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { airportsData } from '../../data/airports';

const posts = await getCollection('blog');
const sortedPosts = [...posts].sort(
  (a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf()
);

const corePages = [
  {
    name: '首页（2027机场推荐主门户）',
    href: '/',
    priority: '1.0',
    desc: '收录 2027 年 35+ 优质机场精选榜单、核心指标面板与全站导航入口。',
  },
  {
    name: '2027 机场推荐排行榜',
    href: '/ranking/',
    priority: '0.9',
    desc: '支持场景筛选，包含隐形人旗舰大卡片与其余 34 家一排五个评测矩阵。',
  },
  {
    name: '35+ 机场横向参数对比表',
    href: '/comparison/',
    priority: '0.9',
    desc: '按基础流量、起步价钱、协议、晚高峰实测速率与核心优势横向检索对比。',
  },
  {
    name: '三大运营商选线指南（电信/联通/移动）',
    href: '/isp-guide/',
    priority: '0.9',
    desc: '针对电信 163 拥堵、联通 AS4837/9929、移动 CMIN2 与校园网的专属选线建议。',
  },
  {
    name: '深度评测与教程专栏',
    href: '/posts/',
    priority: '0.8',
    desc: '汇集 Clash Verge Rev / Sing-box 教程、IEPL 专线对比及 AI 解锁测评报告。',
  },
  {
    name: '关于本站与独立评测标准',
    href: '/about/',
    priority: '0.6',
    desc: '了解自费订阅测评体系、晚高峰测试环境与合规免责声明。',
  },
];

const title = '站点地图 (Sitemap) - 2027机场推荐 | newjichangtuijian.blog';
const description = '浏览 2027机场推荐（newjichangtuijian.blog）完整网站地图（HTML Sitemap & XML Sitemap），快速直达全部排行榜、对比表、运营商选线、深度评测文章与收录品牌索引。';
const keywords = '站点地图, Sitemap, 2027机场推荐导航, newjichangtuijian.blog, XML Sitemap';

const breadcrumbs = [
  { name: '站点地图', url: '/sitemap/' },
];
---

<BaseLayout title={title} description={description} keywords={keywords} breadcrumbs={breadcrumbs}>
  <div class="max-w-6xl mx-auto">
    <Breadcrumb items={breadcrumbs} />

    <header class="py-8 border-b border-slate-200 mb-10">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full text-xs font-semibold bg-sky-50 text-sky-700 border border-sky-200 mb-4">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>全站结构化索引 · 支持 Bing / Google 标准 XML Sitemap</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        全站站点地图 (Sitemap)
      </h1>
      <p class="text-slate-600 text-sm sm:text-base mt-3 max-w-3xl leading-relaxed">
        一站式索引 <strong>newjichangtuijian.blog</strong> 所有核心频道页面、深度测评与使用教程文章，同时提供标准 XML 站点地图供搜索引擎（Bing / Google）抓取与站长后台提交。
      </p>

      <!-- XML Sitemap 站长提交快捷栏 -->
      <div class="mt-6 p-4 sm:p-5 rounded-2xl bg-white border border-slate-200 shadow-sm grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
        <div class="p-3 rounded-xl bg-sky-50/70 border border-sky-100 flex flex-col justify-between">
          <div>
            <div class="font-bold text-slate-900 mb-1">标准单文件 XML Sitemap（推荐提交）</div>
            <code class="text-sky-700 font-mono break-all text-[11px]">https://newjichangtuijian.blog/sitemap.xml</code>
          </div>
          <div class="mt-2.5 flex items-center gap-2">
            <a href="/sitemap.xml" target="_blank" class="px-2.5 py-1 rounded bg-sky-600 text-white font-semibold hover:bg-sky-500 transition-colors">
              查看 XML ↗
            </a>
            <button type="button" class="copy-sitemap-btn px-2.5 py-1 rounded bg-white border border-slate-300 text-slate-700 font-semibold hover:border-sky-400 transition-colors" data-copy="https://newjichangtuijian.blog/sitemap.xml">
              复制地址
            </button>
          </div>
        </div>

        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 flex flex-col justify-between">
          <div>
            <div class="font-bold text-slate-900 mb-1">索引型 Sitemap Index</div>
            <code class="text-slate-700 font-mono break-all text-[11px]">https://newjichangtuijian.blog/sitemap-index.xml</code>
          </div>
          <div class="mt-2.5 flex items-center gap-2">
            <a href="/sitemap-index.xml" target="_blank" class="px-2.5 py-1 rounded bg-slate-800 text-white font-semibold hover:bg-slate-700 transition-colors">
              查看 Index ↗
            </a>
            <button type="button" class="copy-sitemap-btn px-2.5 py-1 rounded bg-white border border-slate-300 text-slate-700 font-semibold hover:border-sky-400 transition-colors" data-copy="https://newjichangtuijian.blog/sitemap-index.xml">
              复制地址
            </button>
          </div>
        </div>

        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 flex flex-col justify-between">
          <div>
            <div class="font-bold text-slate-900 mb-1">爬虫引导文件 Robots.txt</div>
            <code class="text-slate-700 font-mono break-all text-[11px]">https://newjichangtuijian.blog/robots.txt</code>
          </div>
          <div class="mt-2.5 flex items-center gap-2">
            <a href="/robots.txt" target="_blank" class="px-2.5 py-1 rounded bg-slate-800 text-white font-semibold hover:bg-slate-700 transition-colors">
              查看 Robots ↗
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- 一、核心频道页面 -->
    <section class="mb-12">
      <h2 class="text-xl font-bold text-slate-900 mb-5 flex items-center">
        <span class="w-2.5 h-2.5 rounded-full bg-sky-500 mr-2.5"></span>
        一、核心频道与独立专页 ({corePages.length})
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {corePages.map((page) => (
          <a
            href={page.href}
            class="p-5 rounded-2xl bg-white border border-slate-200 hover:border-sky-400 hover:shadow-md transition-all group flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <h3 class="font-bold text-slate-900 group-hover:text-sky-600 transition-colors text-base">
                  {page.name}
                </h3>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-sky-50 text-sky-700 border border-sky-100 shrink-0">
                  权重 {page.priority}
                </span>
              </div>
              <p class="text-xs text-slate-500 leading-relaxed">{page.desc}</p>
            </div>
            <div class="mt-3 pt-2 border-t border-slate-100 text-[11px] font-mono text-sky-600 flex items-center justify-between">
              <span>{page.href}</span>
              <span>访问页面 →</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- 二、深度评测与技术文章 -->
    <section class="mb-12">
      <h2 class="text-xl font-bold text-slate-900 mb-5 flex items-center">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 mr-2.5"></span>
        二、深度评测与客户端教程文章 ({sortedPosts.length})
      </h2>
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm divide-y divide-slate-100">
        {sortedPosts.map((post) => {
          const dateStr = (post.data.updatedDate ?? post.data.pubDate).toISOString().split('T')[0];
          return (
            <div class="p-4 sm:p-5 hover:bg-sky-50/40 transition-colors flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div class="space-y-1">
                <a href={`/posts/${post.slug}/`} class="font-bold text-slate-900 hover:text-sky-600 transition-colors text-sm sm:text-base block">
                  {post.data.title}
                </a>
                <p class="text-xs text-slate-500 line-clamp-1">{post.data.description}</p>
                <div class="flex flex-wrap gap-1.5 pt-1">
                  {post.data.tags.map((tag) => (
                    <span class="text-[10px] px-2 py-0.5 rounded bg-slate-100 text-slate-600 border border-slate-200">
                      #{tag}
                    </span>
                  ))}
                </div>
              </div>
              <div class="flex sm:flex-col items-center sm:items-end justify-between gap-2 shrink-0 text-xs">
                <span class="font-mono text-slate-400">更新于 {dateStr}</span>
                <a href={`/posts/${post.slug}/`} class="text-sky-600 font-semibold hover:underline whitespace-nowrap">
                  阅读全文 →
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- 三、收录的 35 家优质机场品牌索引 -->
    <section class="mb-12">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-5">
        <h2 class="text-xl font-bold text-slate-900 flex items-center">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-500 mr-2.5"></span>
          三、收录优质机场品牌速览索引 ({airportsData.length} 家)
        </h2>
        <a href="/comparison/" class="text-xs font-semibold text-sky-600 hover:underline">
          前往横向对比表筛选全部参数 →
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2.5">
        {airportsData.map((airport) => (
          <a
            href={airport.affUrl}
            target="_blank"
            rel="nofollow noopener noreferrer"
            class="p-3 rounded-xl bg-white border border-slate-200 hover:border-sky-400 hover:shadow-sm transition-all flex flex-col justify-between text-xs group"
          >
            <div class="flex items-center justify-between gap-1 mb-1">
              <span class="font-mono text-[10px] font-bold text-slate-400">#{airport.rank}</span>
              <span class="font-mono text-[11px] font-bold text-sky-600">{airport.entryPrice}</span>
            </div>
            <div class="font-bold text-slate-900 group-hover:text-sky-600 truncate" title={airport.name}>
              {airport.name}
            </div>
            <div class="text-[10px] text-slate-500 truncate mt-0.5 font-mono">
              {airport.trafficQuota || '高速专线'}
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.copy-sitemap-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-copy');
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
          const original = btn.textContent;
          btn.textContent = '已复制 ✓';
          btn.classList.add('text-emerald-600', 'border-emerald-300');
          setTimeout(() => {
            btn.textContent = original;
            btn.classList.remove('text-emerald-600', 'border-emerald-300');
          }, 1800);
        } catch {
          // ignore clipboard errors
        }
      });
    });
  });
</script>
